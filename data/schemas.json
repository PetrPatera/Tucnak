{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tucnakuvsvet.cz/schemas/v1/schemas.json",
  "title": "Tučňákův svět – Datová schémata aplikace",
  "description": "Kompletní JSON schémata pro katalog 5 zón / 22 aktivit a audio manifest českého dabingu.",
  "$defs": {
    "ActivityCatalogSchema": {
      "type": "object",
      "required": ["version", "locale", "zones", "activities"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "locale": {
          "type": "string",
          "const": "cs-CZ"
        },
        "zones": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/Zone" }
        },
        "activities": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": { "$ref": "#/$defs/Activity" }
        }
      }
    },
    "Zone": {
      "type": "object",
      "required": ["id", "title", "subtitle", "themeColor", "accentColor", "icon", "audioIntroId", "position"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": ["zone_a", "zone_b", "zone_c", "zone_d", "zone_e"]
        },
        "title": { "type": "string", "minLength": 2 },
        "subtitle": { "type": "string", "minLength": 2 },
        "themeColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "icon": { "type": "string" },
        "audioIntroId": { "type": "string" },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 100 },
            "y": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "Activity": {
      "type": "object",
      "required": [
        "id",
        "number",
        "zoneId",
        "title",
        "shortTitle",
        "icon",
        "type",
        "implementedInPrototype",
        "pedagogicalGoal",
        "audioIntroId",
        "levels"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^act_\\d{2}_[a-z_]+$" },
        "number": { "type": "integer", "minimum": 1, "maximum": 22 },
        "zoneId": {
          "type": "string",
          "enum": ["zone_a", "zone_b", "zone_c", "zone_d", "zone_e"]
        },
        "title": { "type": "string" },
        "shortTitle": { "type": "string" },
        "icon": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "step_draw",
            "color_mix",
            "symmetry_draw",
            "story_draw",
            "connect_dots",
            "tangram",
            "shadow_match",
            "visual_detective",
            "puzzle",
            "first_letter",
            "syllables",
            "letter_track",
            "rhyme_memory",
            "feed_penguin",
            "ice_scales",
            "story_math",
            "size_sort",
            "pattern_complete",
            "ice_maze",
            "sound_memory",
            "coding_path",
            "matrix_sort"
          ]
        },
        "implementedInPrototype": { "type": "boolean" },
        "pedagogicalGoal": { "type": "string" },
        "audioIntroId": { "type": "string" },
        "levels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/ActivityLevel" }
        }
      }
    },
    "ActivityLevel": {
      "type": "object",
      "required": ["stars", "label", "config", "hintAudioIds", "successAudioId"],
      "additionalProperties": false,
      "properties": {
        "stars": { "type": "integer", "enum": [1, 2, 3] },
        "label": { "type": "string" },
        "config": { "type": "object" },
        "hintAudioIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "successAudioId": { "type": "string" }
      }
    },
    "AudioManifestSchema": {
      "type": "object",
      "required": ["version", "defaultVoice", "fallbackVoice", "defaultRate", "defaultPitch", "entries"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "defaultVoice": { "type": "string" },
        "fallbackVoice": { "type": "string" },
        "defaultRate": { "type": "string", "pattern": "^[+-]\\d+%$" },
        "defaultPitch": { "type": "string", "pattern": "^[+-]\\d+Hz$" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/AudioEntry" }
        }
      }
    },
    "AudioEntry": {
      "type": "object",
      "required": ["id", "category", "text_cs", "karaoke_text", "intonation_note", "voice", "rate", "pitch", "file"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "category": {
          "type": "string",
          "enum": ["system", "zone", "activity_intro", "drawing", "hint", "number", "celebrate", "bedtime"]
        },
        "text_cs": { "type": "string", "minLength": 1 },
        "karaoke_text": { "type": "string", "minLength": 1 },
        "intonation_note": { "type": "string", "minLength": 2 },
        "voice": { "type": "string" },
        "rate": { "type": "string", "pattern": "^[+-]\\d+%$" },
        "pitch": { "type": "string", "pattern": "^[+-]\\d+Hz$" },
        "file": { "type": "string", "pattern": "^assets/audio/[a-z0-9_]+\\.mp3$" }
      }
    }
  }
}
